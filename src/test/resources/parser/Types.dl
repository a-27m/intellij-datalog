.type Id = number
.type Label <: symbol
.symbol_type Name
.number_type Year

.type Pair = [a: number, b: number]
.type Person = [name: Name, born: Year]
.type List = [head: number, tail: List]
.type Nothing = []
.type Either = Id | Label
.type Id2 = number
.type Many = Id | Label | Id2
.type Alias = Pair

.decl useTypes(p: Person, i: Id, l: Label, e: Either)
